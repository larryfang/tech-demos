# Required for any call to MessageMedia. Without them the console shows "Credentials required".
# MESSAGEMEDIA_API_KEY=
# MESSAGEMEDIA_API_SECRET=

# basic (default) or hmac — must match the type of API key you created in the MessageMedia hub.
# MESSAGEMEDIA_AUTH_MODE=basic

# APAC (default) https://api.messagemedia.com · EU https://eu.app.api.sinch.com
# MESSAGEMEDIA_BASE_URL=https://api.messagemedia.com

# Optional sender: +E.164 number, short code digits, or an approved alphanumeric ID.
# MESSAGEMEDIA_SOURCE_NUMBER=
